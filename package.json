{
  "name": "sports-news-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @sports/web dev",
    "dev:admin": "pnpm --filter @sports/admin dev",
    "dev:api": "pnpm --filter @sports/api dev",
    "start:web": "pnpm --filter @sports/web start",
    "start:admin": "pnpm --filter @sports/admin start",
    "start:api": "pnpm --filter @sports/api start",
    "build": "turbo build --concurrency=1",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @sports/db prisma:generate",
    "db:push": "pnpm --filter @sports/db prisma:push",
    "db:seed": "pnpm --filter @sports/db seed"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.25",
    "prettier": "3.3.3",
    "turbo": "2.3.3",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
